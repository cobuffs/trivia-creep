{
  "name": "trivia-creep",
  "version": "1.0.0",
  "description": "Discord trivia bot with scrapers for various trivia sources",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot/index.js",
    "dev": "ts-node src/bot/index.ts",
    "setup:database": "ts-node helper-scripts/create-bot-tables.ts",
    "scrape:jarchive": "ts-node helper-scripts/j-archive-scraper.ts",
    "scrape:jarchive:season": "ts-node helper-scripts/j-archive-scraper.ts --season",
    "scrape:jarchive:game": "ts-node helper-scripts/j-archive-scraper.ts --game-id"
  },
  "keywords": [
    "discord",
    "bot",
    "trivia",
    "jeopardy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "mssql": "^10.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/mssql": "^9.1.8",
    "@types/node": "^20.10.0",
    "@types/yargs": "^17.0.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
